             "type": "Navigation",
             "props": {
              "items": [
               {
                "label": "Accueil",
                "path": "/",
                "icon": "House"
               },
               {
                "label": "Opportunités clients",
                "path": "/opportunites-clients",
                "icon": "Users"
               },
               {
                "label": "Opportunités de biens",
                "path": "/opportunites-biens",
                "icon": "KeyRound"
               },
               {
                "label": "Biens",
                "path": "/biens",
                "icon": "Building2"
               },
               {
                "label": "Agenda",
                "path": "/agenda",
