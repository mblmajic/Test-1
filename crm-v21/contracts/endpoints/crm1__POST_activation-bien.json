{
  "id": "f72e5cf5-4708-432e-98fc-63180e4ab94a",
  "name": "CRM1 — Activer le bien lié",
  "description": "",
  "definition": {
    "method": "POST",
    "path": "/crm1/activation-bien",
    "auth": {
      "type": "jwt"
    },
    "input": {
      "params": [],
      "query": [],
      "headers": [],
      "body": [
        {
          "name": "id",
          "type": "any",
          "required": true,
          "description": ""
        }
      ]
    },
    "steps": [
      {
        "id": "team",
        "key": "team",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "listRecords",
          "params": {
            "limit": 20,
            "table": "mf37113735cdd038b",
            "columns": [
              "id",
              "broker",
              "actif",
              "email_production",
              "crm_broker_valeur"
            ]
          }
        }
      },
      {
        "id": "identity",
        "key": "identity",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "transform",
        "config": {
          "expression": "($email := $lowercase($string(auth.claims.email)); $admin := auth.claims.sub = '2ed8af88-0a8d-44dc-9b78-852f3c450cd5' or 'dom-admin' in auth.claims.roles or 'Admin Domaine' in auth.claims.roles; $rep := steps.team.rows[$lowercase($string(email_production)) = $email and (actif = true or actif = 'true')][0]; {'admin':$admin,'broker':$admin ? 'Majid' : $rep.crm_broker_valeur,'email':$email,'userId':auth.claims.sub,'allowed':$admin or $exists($rep.id)})"
        }
      },
      {
        "id": "access",
        "key": "access",
        "name": "",
        "runIf": "$not(steps.identity.allowed)",
        "onError": "stop",
        "enabled": true,
        "type": "respond",
        "config": {
          "status": 403,
          "headers": [],
          "body": "{'error':'Votre compte n’est pas associé à un broker actif. Contactez M. Majid.'}"
        }
      },
      {
        "id": "valid_id_0",
        "key": "valid_id_0",
        "name": "",
        "runIf": "$exists(input.body.id) and $string(input.body.id) != '' and $not($contains($string(input.body.id),/^[1-9][0-9]{0,14}$/))",
        "onError": "stop",
        "enabled": true,
        "type": "respond",
        "config": {
          "status": 400,
          "headers": [],
          "body": "{'error':'Identifiant de dossier invalide.'}"
        }
      },
      {
        "id": "op",
        "key": "op",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "transform",
        "config": {
          "expression": "{'id':$string($millis()) & '-' & $string(auth.claims.sub),'date':$now(),'broker':steps.identity.broker}"
        }
      },
      {
        "id": "admin",
        "key": "admin",
        "name": "",
        "runIf": "$not(steps.identity.admin)",
        "onError": "stop",
        "enabled": true,
        "type": "respond",
        "config": {
          "status": 403,
          "headers": [],
          "body": "{\"error\":\"L’activation est réservée à l’administrateur pour cette première version.\"}"
        }
      },
      {
        "id": "record",
        "key": "record",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "getRecord",
          "params": {
            "table": "m13dd0abc30554ba9",
            "recordId": "{{ input.body.id }}",
            "failIfNotFound": true
          }
        }
      },
      {
        "id": "linked",
        "key": "linked",
        "name": "",
        "runIf": "$not(steps.record.pmv6m9j8dh2qj_biens_id)",
        "onError": "stop",
        "enabled": true,
        "type": "respond",
        "config": {
          "status": 409,
          "headers": [],
          "body": "{\"error\":\"Aucun bien principal confirmé. Faites vérifier le rattachement avant activation.\"}"
        }
      },
      {
        "id": "begin",
        "key": "begin",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "createRecord",
          "params": {
            "table": "m638173347625af09",
            "values": "{'libelle':\"Activation du bien lié\",'operation_id':steps.op.id,'date_evenement':$now(),'user_id':auth.claims.sub,'email_auteur':steps.identity.email,'broker':steps.identity.broker,'type_dossier':\"opportunite-bien\",'dossier_id':$string(input.body.id),'type_evenement':\"Activation du bien lié\",'resultat':'À reprendre','source':'SuperAPP_easyspace_CRM1','avant':$string(steps.record)}"
          }
        }
      },
      {
        "id": "activeBien",
        "key": "activeBien",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "updateRecord",
          "params": {
            "table": "ma9b9bb062ad8b271",
            "values": "{'src_ckik8lj9kqev9ho':'Actif'}",
            "recordId": "{{ steps.record.pmv6m9j8dh2qj_biens_id }}"
          }
        }
      },
      {
        "id": "write",
        "key": "write",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "updateRecord",
          "params": {
            "table": "m13dd0abc30554ba9",
            "values": "{'src_cey267rja2wv3lq':'Actif dans la table Biens'}",
            "recordId": "{{ input.body.id }}"
          }
        }
      },
      {
        "id": "finish",
        "key": "finish",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "updateRecord",
          "params": {
            "table": "m638173347625af09",
            "values": "{'resultat':'Réussi','dossier_id':$string(input.body.clientId ? input.body.clientId : steps.write.id),'apres':$string(steps.write)}",
            "recordId": "{{ steps.begin.id }}"
          }
        }
      },
      {
        "id": "done",
        "key": "done",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "respond",
        "config": {
          "status": 201,
          "headers": [],
          "body": "{'id':steps.write.id,'operationId':steps.op.id,'message':'Enregistré'}"
        }
      }
    ],
    "response": {
      "status": 200,
      "headers": [],
      "body": ""
    },
    "docs": {
      "description": "",
      "tags": [],
      "deprecated": false,
      "hidden": false,
      "responseDescription": "",
      "responseExample": ""
    }
  },
