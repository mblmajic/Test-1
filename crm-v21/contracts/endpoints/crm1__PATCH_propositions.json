{
  "id": "0a4c89a6-d968-4ddb-869f-18ef33cd2bfd",
  "name": "CRM1 — Retour sur une proposition",
  "description": "",
  "definition": {
    "method": "PATCH",
    "path": "/crm1/propositions",
    "auth": {
      "type": "jwt"
    },
    "input": {
      "params": [],
      "query": [],
      "headers": [],
      "body": [
        {
          "name": "id",
          "type": "any",
          "required": true,
          "description": ""
        },
        {
          "name": "statut",
          "type": "string",
          "required": true,
          "description": ""
        },
        {
          "name": "retour",
          "type": "string",
          "required": false,
          "description": ""
        }
      ]
    },
    "steps": [
      {
        "id": "team",
        "key": "team",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "listRecords",
          "params": {
            "limit": 20,
            "table": "mf37113735cdd038b",
            "columns": [
              "id",
              "broker",
              "actif",
              "email_production",
              "crm_broker_valeur"
            ]
          }
        }
      },
      {
        "id": "identity",
        "key": "identity",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "transform",
        "config": {
          "expression": "($email := $lowercase($string(auth.claims.email)); $admin := auth.claims.sub = '2ed8af88-0a8d-44dc-9b78-852f3c450cd5' or 'dom-admin' in auth.claims.roles or 'Admin Domaine' in auth.claims.roles; $rep := steps.team.rows[$lowercase($string(email_production)) = $email and (actif = true or actif = 'true')][0]; {'admin':$admin,'broker':$admin ? 'Majid' : $rep.crm_broker_valeur,'email':$email,'userId':auth.claims.sub,'allowed':$admin or $exists($rep.id)})"
        }
      },
      {
        "id": "access",
        "key": "access",
        "name": "",
        "runIf": "$not(steps.identity.allowed)",
        "onError": "stop",
        "enabled": true,
        "type": "respond",
        "config": {
          "status": 403,
          "headers": [],
          "body": "{'error':'Votre compte n’est pas associé à un broker actif. Contactez M. Majid.'}"
        }
      },
      {
        "id": "proposal",
        "key": "proposal",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "getRecord",
          "params": {
            "table": "m5ba929066e4852f4",
            "recordId": "{{ input.body.id }}",
            "failIfNotFound": true
          }
        }
      },
      {
        "id": "client",
        "key": "client",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "getRecord",
          "params": {
            "table": "m80adee8ba2348dfe",
            "recordId": "{{ steps.proposal.opportunit_s_clients_id }}",
            "failIfNotFound": true
          }
        }
      },
      {
        "id": "owner",
        "key": "owner",
        "name": "",
        "runIf": "$not(steps.identity.admin or steps.client.src_c2ljvedgo8rjnjz=steps.identity.broker)",
        "onError": "stop",
        "enabled": true,
        "type": "respond",
        "config": {
          "status": 403,
          "headers": [],
          "body": "{'error':'Accès refusé à ce dossier.'}"
        }
      },
      {
        "id": "status",
        "key": "status",
        "name": "",
        "runIf": "$not(input.body.statut in ['À proposer','Proposé','Intéressé','Refusé','Visite demandée'])",
        "onError": "stop",
        "enabled": true,
        "type": "respond",
        "config": {
          "status": 400,
          "headers": [],
          "body": "{'error':'Statut de proposition non autorisé.'}"
        }
      },
      {
        "id": "write",
        "key": "write",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "updateRecord",
          "params": {
            "table": "m5ba929066e4852f4",
            "values": "{'statut':input.body.statut,'retour_client':input.body.retour}",
            "recordId": "{{ input.body.id }}"
          }
        }
      },
      {
        "id": "journal",
        "key": "journal",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "createRecord",
          "params": {
            "table": "m638173347625af09",
            "values": "{'libelle':'Retour sur proposition','date_evenement':$now(),'email_auteur':steps.identity.email,'broker':steps.identity.broker,'type_dossier':'client','dossier_id':$string(steps.proposal.opportunit_s_clients_id),'type_evenement':'Retour sur proposition','resume':input.body.statut & ' — ' & (input.body.retour ? input.body.retour : ''),'resultat':'Réussi','source':'SuperAPP_easyspace_CRM1','test_crm1':steps.proposal.test_crm1=true}"
          }
        }
      },
      {
        "id": "done",
        "key": "done",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "respond",
        "config": {
          "status": 200,
          "headers": [],
          "body": "{'id':steps.write.id,'message':'Retour enregistré'}"
        }
      }
    ],
    "response": {
      "status": 200,
      "headers": [],
      "body": ""
    },
    "docs": {
      "description": "",
      "tags": [],
      "deprecated": false,
      "hidden": false,
      "responseDescription": "",
      "responseExample": ""
    }
  },
  "status": "published",
  "url": "https://api-studio.tybotflow.com/run/easyspace_schema/crm1/propositions",
