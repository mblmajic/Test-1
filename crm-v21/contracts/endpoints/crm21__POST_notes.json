{
 "name": "CRM21 — Ajouter une note",
 "description": "Note rattachée au dossier, visible dans l'historique.",
 "definition": {
  "method": "POST",
  "path": "/crm21/notes",
  "auth": {
   "type": "jwt"
  },
  "input": {
   "params": [],
   "query": [],
   "headers": [],
   "body": [
    {
     "name": "clientId",
     "type": "any",
     "required": true,
     "description": ""
    },
    {
     "name": "texte",
     "type": "string",
     "required": true,
     "description": ""
    },
    {
     "name": "cle",
     "type": "string",
     "required": false,
     "description": ""
    }
   ]
  },
  "steps": [
   {
    "key": "g401",
    "name": "Session requise",
    "type": "respond",
    "config": {
     "status": 401,
     "headers": [],
     "body": "{'error':'Session expirée. Reconnectez-vous.'}"
    },
    "runIf": "$not($exists(auth.claims.email)) or $string(auth.claims.email) = ''"
   },
   {
    "key": "moi",
    "name": "Membre CRM21",
    "type": "datasource",
    "config": {
     "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
     "operation": "listRecords",
     "params": {
      "table": "m3070c01f4ae9eb21",
      "filters": [
       {
        "column": "email",
        "operator": "eq",
        "value": "{{ $lowercase($string(auth.claims.email)) }}"
       }
      ],
      "columns": [
       "id",
       "email",
       "nom",
       "role",
       "broker",
       "actif"
      ],
      "limit": 1
     }
    }
   },
   {
    "key": "ident",
    "name": "Identité",
    "type": "transform",
    "config": {
     "expression": "(\n($m := steps.moi.rows[0]; $act := $string($m.actif) = 'true'; $r := $string($m.role); $bk := $exists($m.broker) and $type($m.broker) != 'null' ? $string($m.broker) : ''; {'email': $lowercase($string(auth.claims.email)), 'nom': $act ? $string($m.nom) : '', 'role': $act ? $r : '', 'admin': $act and $r = 'Admin', 'broker': $act ? $bk : '', 'ok': $act and ($r = 'Admin' or ($r = 'Broker' and $bk != ''))})\n)"
    }
   },
   {
    "key": "g403",
    "name": "Membre actif requis",
    "type": "respond",
    "config": {
     "status": 403,
     "headers": [],
     "body": "{'error':'Votre compte n’est pas encore activé dans le CRM. Contactez l’administrateur.'}"
    },
    "runIf": "$not(steps.ident.ok)"
   },
   {
    "key": "op",
    "name": "Identifiant d'opération",
    "type": "transform",
    "config": {
     "expression": "(\n{'id': $exists(input.body.cle) and $string(input.body.cle) != '' ? 'v21-' & $string(input.body.cle) : 'v21-' & $string($millis()) & '-' & $substring($string(auth.claims.sub), 0, 8), 'date': $now()}\n)"
    }
   },
   {
    "key": "gid",
    "name": "Id valide",
    "type": "respond",
    "config": {
     "status": 400,
     "headers": [],
     "body": "{'error':'Dossier manquant ou invalide.'}"
    },
    "runIf": "$not($contains($string(input.body.clientId), /^[1-9][0-9]{0,9}$/))"
   },
   {
    "key": "oc",
    "name": "Dossier autorisé",
    "type": "datasource",
    "config": {
     "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
     "operation": "listRecords",
     "params": {
      "table": "m80adee8ba2348dfe",
      "columns": [
       "id",
       "libelle",
       "updated_at",
       "crm_cle_creation",
       "src_c2ljvedgo8rjnjz",
       "src_c8j7pxeprb45sel",
       "src_cu4m58kh70jsaas",
       "src_ch80mhxt9wmgffa",
       "src_cwm9erw27y2a5ax",
       "src_csdkjyu1i3h2rpd",
       "src_caw1n932cne75bt",
       "src_cmt5f5y6apb9n76",
       "src_cp1ak79dze4j7zb",
       "src_crid8q8n1p0n7qe",
       "src_cc9t923zypqax4s",
       "src_cqx1ht4dg6mt0gl",
       "src_cjuumr2e0utdov7",
       "src_c0qcaxijrq4e44n",
       "src_c8ty9timbln0feq",
       "src_cali7clgn81g11x",
       "src_cdivmzu7n1bn63g",
       "src_cj59gxz110km911",
       "src_c90ihchqcq0h8hz",
       "src_csbs48a1es5ynk0",
       "src_csluzp2qkfjfaw0",
       "src_chjo5jv3sbsxelr",
       "pmv6m9j8dh2qj_contacts_id"
      ],
      "limit": 1,
      "filters": [
       {
        "column": "id",
        "operator": "eq",
        "value": "{{ $string(input.body.clientId) }}"
       },
       {
        "column": "src_c2ljvedgo8rjnjz",
        "operator": "eq",
        "value": "{{ steps.ident.admin ? '' : steps.ident.broker }}",
        "skipIfEmpty": true
       }
      ]
     }
    }
   },
   {
    "key": "g404",
    "name": "Propriétaire",
    "type": "respond",
    "config": {
     "status": 404,
     "headers": [],
     "body": "{'error':'Dossier introuvable ou non autorisé.'}"
    },
    "runIf": "$count(steps.oc.rows) = 0"
   },
   {
    "key": "gtx",
    "name": "gtx",
    "type": "respond",
    "config": {
     "status": 400,
     "headers": [],
     "body": "{'error':'La note est vide ou trop longue (5000 caractères max).'}"
    },
    "runIf": "$length($trim($string(input.body.texte))) < 2 or $length($string(input.body.texte)) > 5000"
   },
   {
    "key": "deja",
    "name": "Reprise",
    "type": "datasource",
    "config": {
     "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
     "operation": "listRecords",
     "params": {
      "table": "m638173347625af09",
      "columns": [
       "id"
      ],
      "limit": 1,
      "filters": [
       {
        "column": "operation_id",
        "operator": "eq",
        "value": "{{ steps.op.id }}"
       }
      ]
     }
    }
   },
   {
    "key": "dejafait",
    "name": "dejafait",
    "type": "respond",
    "config": {
     "status": 200,
     "headers": [],
     "body": "{'items':[{'id': steps.deja.rows[0].id, 'message':'Note déjà enregistrée.', 'reprise': true}]}"
    },
    "runIf": "$count(steps.deja.rows) > 0"
   },
   {
    "key": "write",
    "name": "Journal",
    "type": "datasource",
    "config": {
     "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
     "operation": "createRecord",
     "params": {
      "table": "m638173347625af09",
      "values": "{'libelle': 'Note', 'operation_id': steps.op.id, 'date_evenement': $now(), 'user_id': $string(auth.claims.sub), 'email_auteur': steps.ident.email, 'broker': steps.ident.broker, 'type_dossier': 'client', 'dossier_id': $string(input.body.clientId), 'type_evenement': 'Note', 'resume': $substring($string(input.body.texte), 0, 2000), 'apres': $substring($string(''), 0, 2000), 'resultat': 'Réussi', 'source': 'SuperAPP_CRM_V21', 'test_crm1': $contains(($r := steps.oc.rows[0]; $l := $string($r.libelle); $l != '' and $l != 'null' ? $l : 'Dossier #' & $string($r.id)), '[RECETTE V21]')}"
     }
    }
   },
   {
    "key": "done",
    "name": "done",
    "type": "respond",
    "config": {
     "status": 201,
     "headers": [],
     "body": "{'items':[{'id': steps.write.id, 'message':'Note ajoutée.'}]}"
    }
   }
  ],
  "docs": {
   "description": "Note rattachée au dossier, visible dans l'historique."
  }
 }
}