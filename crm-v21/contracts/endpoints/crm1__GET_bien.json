        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "query",
          "params": {
            "query": "{'table':'#ma9b9bb062ad8b271','select':{\"nomGestionnaire\":\"$#c7e5301d105c0af82\",\"telephoneSource\":\"$#cfd2b520e8d89c64c\",\"annonceurId\":\"$#c63f91c75f970faf6\",\"sourceUrl\":\"$#c7d47957c9211e0ca\",\"affectationId\":\"$#ce45e918b92f70bd7\",\"id\":\"$#cef927638d1281ac7\",\"nom\":\"$#c74a21d7938a15475\",\"broker\":\"$#c80dd6bcd775c9afb\",\"statut\":\"$#c42d9ccce4721f259\",\"typeBien\":\"$#cb6fa4c193a7f3ca3\",\"prix\":\"$#cb81acce0f7958fa8\",\"surface\":\"$#c53403672dd2099e8\",\"quartier\":\"$#c69283d6151dd971d\",\"ville\":\"$#c757bf9165102d3fa\",\"adresse\":\"$#c3f74067ddfc2767d\",\"transaction\":\"$#c17aedc8bc2758038\",\"photos\":\"$#cb20b12f7de78668a\",\"action\":\"$#c7ee4b5edb459868f\",\"echeance\":\"$#c13d20c8c0a799c8c\",\"notes\":\"$#c5e2fe0ad0c18c42c\"},'where':{'#cef927638d1281ac7':input.query.id ? $number(input.query.id) : undefined},'page':1,'pageSize':500}",
            "result": "response"
          }
        }
      },
      {
        "id": "affectation",
        "key": "affectation",
        "name": "",
        "runIf": "$exists(steps.rows.data[0].affectationId) and steps.rows.data[0].affectationId != null",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "getRecord",
          "params": {
            "table": "mf4841a083ad93de7",
            "recordId": "{{ steps.rows.data[0].affectationId }}",
            "failIfNotFound": false
          }
        }
      },
      {
        "id": "annonceur",
        "key": "annonceur",
        "name": "",
        "runIf": "$exists(steps.rows.data[0].annonceurId) and steps.rows.data[0].annonceurId != null",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "getRecord",
          "params": {
            "table": "mbe5ed5789ee26ddc",
            "recordId": "{{ steps.rows.data[0].annonceurId }}",
            "failIfNotFound": false
          }
        }
      },
      {
        "id": "shape",
        "key": "shape",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "transform",
        "config": {
          "expression": "($s := function($v){($exists($v) and $type($v) != 'null') ? $string($v) : ''}; $n := function($v){$s($v) != '' ? $number($v) : null}; {'items':[steps.rows.data.{'id':id,'nom':$s(nom) != '' ? nom : 'Bien #' & $string(id),'broker':$s(broker),'statut':$s(statut),'typeBien':$s(typeBien),'prix':$n(prix),'surface':$n(surface),'quartier':$s(quartier),'ville':$s(ville),'adresse':$s(adresse),'transaction':$s(transaction),'photos':[photos[$not($contains(url,'content.avito.ma'))]],'photoSource':photos[0].url,'estMonBien':broker=$.steps.identity.broker,'action':$s(action),'echeance':$s(echeance),'notes':$s(notes),'gestionnaire':$s($.steps.affectation.nom_gestionnaire_affich),'contactGestionnaire':$s($.steps.affectation.nom_contact_affich),'telephoneGestionnaire':$s($.steps.affectation.tlphone_affich),'emailGestionnaire':$s($.steps.affectation.email_affich),'etatGestionnaire':$s($.steps.affectation.etat_contact),'roleGestionnaire':$s($.steps.affectation.rle_sur_ce_bien)}]})"
        }
      }
    ],
