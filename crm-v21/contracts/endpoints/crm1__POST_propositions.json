{
  "id": "0e915203-ad36-44b4-a2fe-0a2f935683a1",
  "name": "CRM1 — Proposer un bien",
  "description": "",
  "definition": {
    "method": "POST",
    "path": "/crm1/propositions",
    "auth": {
      "type": "jwt"
    },
    "input": {
      "params": [],
      "query": [],
      "headers": [],
      "body": [
        {
          "name": "clientId",
          "type": "any",
          "required": true,
          "description": ""
        },
        {
          "name": "bienId",
          "type": "any",
          "required": true,
          "description": ""
        },
        {
          "name": "test",
          "type": "boolean",
          "required": false,
          "description": ""
        }
      ]
    },
    "steps": [
      {
        "id": "team",
        "key": "team",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "listRecords",
          "params": {
            "limit": 20,
            "table": "mf37113735cdd038b",
            "columns": [
              "id",
              "broker",
              "actif",
              "email_production",
              "crm_broker_valeur"
            ]
          }
        }
      },
      {
        "id": "identity",
        "key": "identity",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "transform",
        "config": {
          "expression": "($email := $lowercase($string(auth.claims.email)); $admin := auth.claims.sub = '2ed8af88-0a8d-44dc-9b78-852f3c450cd5' or 'dom-admin' in auth.claims.roles or 'Admin Domaine' in auth.claims.roles; $rep := steps.team.rows[$lowercase($string(email_production)) = $email and (actif = true or actif = 'true')][0]; {'admin':$admin,'broker':$admin ? 'Majid' : $rep.crm_broker_valeur,'email':$email,'userId':auth.claims.sub,'allowed':$admin or $exists($rep.id)})"
        }
      },
      {
        "id": "access",
        "key": "access",
        "name": "",
        "runIf": "$not(steps.identity.allowed)",
        "onError": "stop",
        "enabled": true,
        "type": "respond",
        "config": {
          "status": 403,
          "headers": [],
          "body": "{'error':'Votre compte n’est pas associé à un broker actif. Contactez M. Majid.'}"
        }
      },
      {
        "id": "valid_id_0",
        "key": "valid_id_0",
        "name": "",
        "runIf": "$exists(input.body.clientId) and $string(input.body.clientId) != '' and $not($contains($string(input.body.clientId),/^[1-9][0-9]{0,14}$/))",
        "onError": "stop",
        "enabled": true,
        "type": "respond",
        "config": {
          "status": 400,
          "headers": [],
          "body": "{'error':'Identifiant de dossier invalide.'}"
        }
      },
      {
        "id": "valid_id_1",
        "key": "valid_id_1",
        "name": "",
        "runIf": "$exists(input.body.bienId) and $string(input.body.bienId) != '' and $not($contains($string(input.body.bienId),/^[1-9][0-9]{0,14}$/))",
        "onError": "stop",
        "enabled": true,
        "type": "respond",
        "config": {
          "status": 400,
          "headers": [],
          "body": "{'error':'Identifiant de dossier invalide.'}"
        }
      },
      {
        "id": "op",
        "key": "op",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "transform",
        "config": {
          "expression": "{'id':$string($millis()) & '-' & $string(auth.claims.sub),'date':$now(),'broker':steps.identity.broker}"
        }
      },
      {
        "id": "needClient",
        "key": "needClient",
        "name": "",
        "runIf": "$not(input.body.clientId)",
        "onError": "stop",
        "enabled": true,
        "type": "respond",
        "config": {
          "status": 400,
          "headers": [],
          "body": "{\"error\":\"Choisissez une opportunité client.\"}"
        }
      },
      {
        "id": "client",
        "key": "client",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "getRecord",
          "params": {
            "table": "m80adee8ba2348dfe",
            "recordId": "{{ input.body.clientId }}",
            "failIfNotFound": true
          }
        }
      },
      {
        "id": "clientOwner",
        "key": "clientOwner",
        "name": "",
        "runIf": "$not(steps.identity.admin or steps.client.src_c2ljvedgo8rjnjz = steps.identity.broker)",
        "onError": "stop",
        "enabled": true,
        "type": "respond",
        "config": {
          "status": 403,
          "headers": [],
          "body": "{\"error\":\"Accès refusé à cette opportunité client.\"}"
        }
      },
      {
        "id": "bien",
        "key": "bien",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "getRecord",
          "params": {
            "table": "ma9b9bb062ad8b271",
            "recordId": "{{ input.body.bienId }}",
            "failIfNotFound": true
          }
        }
      },
      {
        "id": "existing",
        "key": "existing",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "listRecords",
          "params": {
            "limit": 1,
            "table": "m5ba929066e4852f4",
            "columns": [
              "id"
            ],
            "filters": [
              {
                "value": "{{ $string(input.body.clientId) & '-' & $string(input.body.bienId) }}",
                "column": "cle_proposition",
                "operator": "eq"
              }
            ]
          }
        }
      },
      {
        "id": "duplicate",
        "key": "duplicate",
        "name": "",
        "runIf": "$count(steps.existing.rows)>0",
        "onError": "stop",
        "enabled": true,
        "type": "respond",
        "config": {
          "status": 409,
          "headers": [],
          "body": "{\"error\":\"Ce bien est déjà proposé pour ce dossier.\"}"
        }
      },
      {
        "id": "begin",
        "key": "begin",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "createRecord",
          "params": {
            "table": "m638173347625af09",
            "values": "{'libelle':\"Proposition de bien\",'operation_id':steps.op.id,'date_evenement':$now(),'user_id':auth.claims.sub,'email_auteur':steps.identity.email,'broker':steps.identity.broker,'type_dossier':\"client\",'dossier_id':$string(input.body.clientId ? input.body.clientId : input.body.id),'type_evenement':\"Proposition de bien\",'resultat':'À reprendre','source':'SuperAPP_easyspace_CRM1','test_crm1':input.body.test = true}"
          }
        }
      },
      {
        "id": "write",
        "key": "write",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "createRecord",
          "params": {
            "table": "m5ba929066e4852f4",
            "values": "{'libelle':steps.client.libelle & ' — ' & steps.bien.libelle,'cle_proposition':$string(input.body.clientId)&'-'&$string(input.body.bienId),'opportunit_s_clients_id':input.body.clientId,'pmv6m9j8dh2qj_biens_id':input.body.bienId,'broker':steps.client.src_c2ljvedgo8rjnjz,'email_auteur':steps.identity.email,'date_proposition':$now(),'statut':'Proposé','provenance':'Broker','operation_id':steps.op.id,'test_crm1':input.body.test=true}"
          }
        }
      },
      {
        "id": "finish",
        "key": "finish",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "updateRecord",
          "params": {
            "table": "m638173347625af09",
            "values": "{'resultat':'Réussi','dossier_id':$string(input.body.clientId ? input.body.clientId : steps.write.id),'apres':$string(steps.write)}",
            "recordId": "{{ steps.begin.id }}"
          }
        }
      },
      {
        "id": "done",
        "key": "done",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "respond",
        "config": {
          "status": 201,
          "headers": [],
          "body": "{'id':steps.write.id,'operationId':steps.op.id,'message':'Enregistré'}"
        }
      }
    ],
    "response": {
      "status": 200,
      "headers": [],
      "body": ""
    },
    "docs": {
      "description": "",
      "tags": [],
      "deprecated": false,
      "hidden": false,
      "responseDescription": "",
      "responseExample": ""
    }
  },
