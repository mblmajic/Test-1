{
 "name": "CRM21 — Suivi d'un bien",
 "description": "Confirmer la disponibilité, changer le statut ou ajouter une note ; broker principal ou admin.",
 "definition": {
  "method": "PATCH",
  "path": "/crm21/biens",
  "auth": {
   "type": "jwt"
  },
  "input": {
   "params": [],
   "query": [],
   "headers": [],
   "body": [
    {
     "name": "id",
     "type": "any",
     "required": true,
     "description": ""
    },
    {
     "name": "confirmerDispo",
     "type": "any",
     "required": false,
     "description": ""
    },
    {
     "name": "dispo",
     "type": "string",
     "required": false,
     "description": ""
    },
    {
     "name": "prochaineAction",
     "type": "string",
     "required": false,
     "description": ""
    },
    {
     "name": "notes",
     "type": "string",
     "required": false,
     "description": ""
    }
   ]
  },
  "steps": [
   {
    "key": "g401",
    "name": "Session requise",
    "type": "respond",
    "config": {
     "status": 401,
     "headers": [],
     "body": "{'error':'Session expirée. Reconnectez-vous.'}"
    },
    "runIf": "$not($exists(auth.claims.email)) or $string(auth.claims.email) = ''"
   },
   {
    "key": "moi",
    "name": "Membre CRM21",
    "type": "datasource",
    "config": {
     "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
     "operation": "listRecords",
     "params": {
      "table": "m3070c01f4ae9eb21",
      "filters": [
       {
        "column": "email",
        "operator": "eq",
        "value": "{{ $lowercase($string(auth.claims.email)) }}"
       }
      ],
      "columns": [
       "id",
       "email",
       "nom",
       "role",
       "broker",
       "actif"
      ],
      "limit": 1
     }
    }
   },
   {
    "key": "ident",
    "name": "Identité",
    "type": "transform",
    "config": {
     "expression": "($m := steps.moi.rows[0]; $act := $string($m.actif) = 'true'; $r := $string($m.role); $bk := $exists($m.broker) and $type($m.broker) != 'null' ? $string($m.broker) : ''; {'email': $lowercase($string(auth.claims.email)), 'nom': $act ? $string($m.nom) : '', 'role': $act ? $r : '', 'admin': $act and $r = 'Admin', 'broker': $act ? $bk : '', 'ok': $act and ($r = 'Admin' or ($r = 'Broker' and $bk != ''))})"
    }
   },
   {
    "key": "g403",
    "name": "Membre actif requis",
    "type": "respond",
    "config": {
     "status": 403,
     "headers": [],
     "body": "{'error':'Votre compte n’est pas encore activé dans le CRM. Contactez l’administrateur.'}"
    },
    "runIf": "$not(steps.ident.ok)"
   },
   {
    "key": "per",
    "name": "Périodes horaires",
    "type": "datasource",
    "config": {
     "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
     "operation": "listRecords",
     "params": {
      "table": "m417041728cf6ca7e",
      "columns": [
       "debut_utc",
       "fin_utc",
       "decalage_min"
      ],
      "limit": 50
     }
    }
   },
   {
    "key": "op",
    "name": "Identifiant d'opération",
    "type": "transform",
    "config": {
     "expression": "{'id': $exists(input.body.cle) and $string(input.body.cle) != '' ? 'v21-' & $string(input.body.cle) : 'v21-' & $string($millis()) & '-' & $substring($string(auth.claims.sub), 0, 8), 'date': $now()}"
    }
   },
   {
    "key": "gid",
    "name": "gid",
    "type": "respond",
    "config": {
     "status": 400,
     "headers": [],
     "body": "{'error':'Bien manquant.'}"
    },
    "runIf": "$not($contains($string(input.body.id), /^[1-9][0-9]{0,9}$/))"
   },
   {
    "key": "gdis",
    "name": "gdis",
    "type": "respond",
    "config": {
     "status": 400,
     "headers": [],
     "body": "{'error':'Disponibilité inconnue.'}"
    },
    "runIf": "$exists(input.body.dispo) and $not(input.body.dispo in ['Actif', 'Inactif'])"
   },
   {
    "key": "glen",
    "name": "glen",
    "type": "respond",
    "config": {
     "status": 400,
     "headers": [],
     "body": "{'error':'Texte trop long.'}"
    },
    "runIf": "$length($string(input.body.notes)) > 4000"
   },
   {
    "key": "bien",
    "name": "bien",
    "type": "datasource",
    "config": {
     "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
     "operation": "listRecords",
     "params": {
      "table": "ma9b9bb062ad8b271",
      "columns": [
       "id",
       "libelle",
       "src_c9w1scpswzkjl7g",
       "crm_notes_suivi"
      ],
      "limit": 1,
      "filters": [
       {
        "column": "id",
        "operator": "eq",
        "value": "{{ $string(input.body.id) }}"
       }
      ]
     }
    }
   },
   {
    "key": "g404",
    "name": "g404",
    "type": "respond",
    "config": {
     "status": 404,
     "headers": [],
     "body": "{'error':'Bien introuvable.'}"
    },
    "runIf": "$count(steps.bien.rows) = 0"
   },
   {
    "key": "gown",
    "name": "gown",
    "type": "respond",
    "config": {
     "status": 403,
     "headers": [],
     "body": "{'error':'Seul le broker principal du bien ou l’administrateur peut le modifier.'}"
    },
    "runIf": "$not(steps.ident.admin or $string(steps.bien.rows[0].src_c9w1scpswzkjl7g) = steps.ident.broker)"
   },
   {
    "key": "v",
    "name": "Champs autorisés",
    "type": "transform",
    "config": {
     "expression": "\n$B := $$.input.body; $r := $$.steps.bien.rows[0];\n$v := $merge([\n  $B.confirmerDispo = true or $B.confirmerDispo = 'true' ? {'date_confirmation_dispo': $substring($now(), 0, 10), 'src_ckik8lj9kqev9ho': 'Actif'} : {},\n  $exists($B.dispo) ? {'src_ckik8lj9kqev9ho': $B.dispo} : {},\n  $exists($B.prochaineAction) ? {'crm_prochaine_action': $B.prochaineAction} : {},\n  $exists($B.notes) and $B.notes != '' ? {'crm_notes_suivi': $trim(($exists($r.crm_notes_suivi) and $type($r.crm_notes_suivi) != 'null' ? $string($r.crm_notes_suivi) : '') & '\\n[' & $substring($now(), 0, 10) & '] ' & $B.notes)} : {}\n]);\n{'values': $v, 'n': $count($keys($v))}\n"
    }
   },
   {
    "key": "gvide",
    "name": "gvide",
    "type": "respond",
    "config": {
     "status": 400,
     "headers": [],
     "body": "{'error':'Aucune modification.'}"
    },
    "runIf": "steps.v.n = 0"
   },
   {
    "key": "write",
    "name": "write",
    "type": "datasource",
    "config": {
     "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
     "operation": "updateRecord",
     "params": {
      "table": "ma9b9bb062ad8b271",
      "recordId": "{{ $string(input.body.id) }}",
      "values": "steps.v.values",
      "failIfNotFound": true
     }
    }
   },
   {
    "key": "j",
    "name": "Journal",
    "type": "datasource",
    "config": {
     "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
     "operation": "createRecord",
     "params": {
      "table": "m638173347625af09",
      "values": "{'libelle': 'Suivi du bien', 'operation_id': steps.op.id, 'date_evenement': $now(), 'user_id': $string(auth.claims.sub), 'email_auteur': steps.ident.email, 'broker': steps.ident.broker, 'type_dossier': 'bien', 'dossier_id': $string(input.body.id), 'type_evenement': 'Suivi du bien', 'resume': $substring($string($join($keys(steps.v.values), ', ')), 0, 2000), 'apres': $substring($string(steps.v.values), 0, 2000), 'resultat': 'Réussi', 'source': 'SuperAPP_CRM_V21', 'test_crm1': $contains($string(steps.bien.rows[0].libelle), '[RECETTE V21]')}"
     }
    }
   },
   {
    "key": "done",
    "name": "done",
    "type": "respond",
    "config": {
     "status": 200,
     "headers": [],
     "body": "{'items':[{'id': $number($string(input.body.id)), 'message':'Bien mis à jour.'}]}"
    }
   }
  ],
  "docs": {
   "description": "Confirmer la disponibilité, changer le statut ou ajouter une note ; broker principal ou admin."
  }
 }
}