{
  "id": "0d137ed9-7563-4d7f-a918-bf5663691394",
  "name": "CRM1 — Biens à actualiser",
  "description": "",
  "definition": {
    "method": "GET",
    "path": "/crm1/accueil/biens-a-actualiser",
    "auth": {
      "type": "jwt"
    },
    "input": {
      "params": [],
      "query": [],
      "headers": [],
      "body": []
    },
    "steps": [
      {
        "id": "team",
        "key": "team",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "listRecords",
          "params": {
            "limit": 20,
            "table": "mf37113735cdd038b",
            "columns": [
              "id",
              "broker",
              "actif",
              "email_production",
              "crm_broker_valeur"
            ]
          }
        }
      },
      {
        "id": "identity",
        "key": "identity",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "transform",
        "config": {
          "expression": "($email := $lowercase($string(auth.claims.email)); $admin := auth.claims.sub = '2ed8af88-0a8d-44dc-9b78-852f3c450cd5' or 'dom-admin' in auth.claims.roles or 'Admin Domaine' in auth.claims.roles; $rep := steps.team.rows[$lowercase($string(email_production)) = $email and (actif = true or actif = 'true')][0]; {'admin':$admin,'broker':$admin ? 'Majid' : $rep.crm_broker_valeur,'email':$email,'userId':auth.claims.sub,'allowed':$admin or $exists($rep.id)})"
        }
      },
      {
        "id": "access",
        "key": "access",
        "name": "",
        "runIf": "$not(steps.identity.allowed)",
        "onError": "stop",
        "enabled": true,
        "type": "respond",
        "config": {
          "status": 403,
          "headers": [],
          "body": "{'error':'Votre compte n’est pas associé à un broker actif. Contactez M. Majid.'}"
        }
      },
      {
        "id": "rows",
        "key": "rows",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "datasource",
        "config": {
          "dataSourceId": "de074ee7-7e90-4df1-bd97-6f53613204bc",
          "operation": "query",
          "params": {
            "query": "{'table':'#ma9b9bb062ad8b271','select':{\"id\":\"$#cef927638d1281ac7\",\"nom\":\"$#c74a21d7938a15475\",\"broker\":\"$#c80dd6bcd775c9afb\",\"statut\":\"$#c42d9ccce4721f259\",\"typeBien\":\"$#cb6fa4c193a7f3ca3\",\"prix\":\"$#cb81acce0f7958fa8\",\"surface\":\"$#c53403672dd2099e8\",\"quartier\":\"$#c69283d6151dd971d\",\"ville\":\"$#c757bf9165102d3fa\",\"adresse\":\"$#c3f74067ddfc2767d\",\"transaction\":\"$#c17aedc8bc2758038\",\"photos\":\"$#cb20b12f7de78668a\",\"action\":\"$#c7ee4b5edb459868f\",\"echeance\":\"$#c13d20c8c0a799c8c\",\"notes\":\"$#c5e2fe0ad0c18c42c\"},'where':{'#cef927638d1281ac7':input.query.id ? $number(input.query.id) : undefined},'page':1,'pageSize':500}",
            "result": "response"
          }
        }
      },
      {
        "id": "normalized",
        "key": "normalized",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "transform",
        "config": {
          "expression": "($s := function($v){($exists($v) and $type($v) != 'null') ? $string($v) : ''}; $n := function($v){$s($v) != '' ? $number($v) : null}; {'items':[steps.rows.data.{'id':id,'nom':$s(nom) != '' ? nom : 'Bien #' & $string(id),'broker':$s(broker),'statut':$s(statut),'typeBien':$s(typeBien),'prix':$n(prix),'surface':$n(surface),'quartier':$s(quartier),'ville':$s(ville),'adresse':$s(adresse),'transaction':$s(transaction),'photos':[photos[$not($contains(url,'content.avito.ma'))]],'photoSource':photos[0].url,'estMonBien':broker=$.steps.identity.broker,'action':$s(action),'echeance':$s(echeance),'notes':$s(notes)}]})"
        }
      },
      {
        "id": "shape",
        "key": "shape",
        "name": "",
        "runIf": "",
        "onError": "stop",
        "enabled": true,
        "type": "transform",
        "config": {
          "expression": "{'items':[steps.normalized.items[action != '' or statut = 'À confirmer']]}"
        }
      }
    ],
    "response": {
      "status": 200,
      "headers": [],
      "body": ""
    },
